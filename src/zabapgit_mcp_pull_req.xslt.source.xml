<?sap.transform simple?>
<tt:transform xmlns:tt="http://www.sap.com/transformation-templates">

  <tt:root name="REQUEST"/>

  <tt:template>
    <object>
      <tt:group>
        <tt:cond frq="?">
          <str name="repo"><tt:value ref=".REQUEST.REPO"/></str>
        </tt:cond>
        <tt:cond frq="?">
          <str name="transport"><tt:value ref=".REQUEST.TRANSPORT"/></str>
        </tt:cond>
        <tt:cond frq="?">
          <array name="confirm">
            <tt:loop ref=".REQUEST.CONFIRM">
              <object>
                <tt:group>
                  <tt:cond frq="?">
                    <str name="obj_type"><tt:value ref="OBJ_TYPE"/></str>
                  </tt:cond>
                  <tt:cond frq="?">
                    <str name="obj_name"><tt:value ref="OBJ_NAME"/></str>
                  </tt:cond>
                  <tt:cond frq="?">
                    <str name="action"><tt:value ref="ACTION"/></str>
                  </tt:cond>
                </tt:group>
              </object>
            </tt:loop>
          </array>
        </tt:cond>
      </tt:group>
    </object>
  </tt:template>

</tt:transform>
