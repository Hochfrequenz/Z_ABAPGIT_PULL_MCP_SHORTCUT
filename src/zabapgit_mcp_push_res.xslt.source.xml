<?sap.transform simple?>
<tt:transform xmlns:tt="http://www.sap.com/transformation-templates">

  <tt:root name="RESULT"/>

  <tt:template>
    <object>
      <str name="status"><tt:value ref=".RESULT.STATUS"/></str>
      <tt:cond s-check="not-initial(RESULT.COMMIT)">
        <str name="commit"><tt:value ref=".RESULT.COMMIT"/></str>
      </tt:cond>
      <object name="author">
        <str name="name"><tt:value ref=".RESULT.AUTHOR.NAME"/></str>
        <str name="email"><tt:value ref=".RESULT.AUTHOR.EMAIL"/></str>
      </object>
      <array name="files">
        <tt:loop ref=".RESULT.FILES">
          <object>
            <str name="path"><tt:value ref="PATH"/></str>
            <str name="filename"><tt:value ref="FILENAME"/></str>
            <str name="action"><tt:value ref="ACTION"/></str>
          </object>
        </tt:loop>
      </array>
    </object>
  </tt:template>

</tt:transform>
